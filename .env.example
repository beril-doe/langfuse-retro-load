# Copy to .env beside these scripts and fill in. Never commit the filled copy.
#
# retro_load.py loads this file with python-dotenv before importing langfuse.
# langfuse_admin.py prefers a .env here over ~/.env, matching the pod setup.
#
# Two sets, because the two tools read different names and filling in only one
# leaves the other reporting that no key names your project.
#
# retro_load.py and the vendored hook read the unprefixed names, which is what
# the Langfuse SDK itself expects.

LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://us.cloud.langfuse.com

# langfuse_admin.py reads prefixed names and matches PROJECT_ID against the
# --project you pass, so it cannot act on a project you did not name. Use any
# prefix you like; BERIL is an example. Repeat the block per project.

BERIL_LANGFUSE_PROJECT_ID=
BERIL_LANGFUSE_PUBLIC_KEY=pk-lf-...
BERIL_LANGFUSE_SECRET_KEY=sk-lf-...
BERIL_LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Organization key, used only by `just projects`. A project key cannot list its
# siblings. Optional.

BERIL_LANGFUSE_ORG_PUBLIC_KEY=
BERIL_LANGFUSE_ORG_SECRET_KEY=

# Optional. Separates sandbox traces from real ones without needing a second
# project. Lowercase, digits, hyphen or underscore, 40 characters maximum, and
# it cannot start with "langfuse".
LANGFUSE_TRACING_ENVIRONMENT=

# Optional, read by the vendored hook. Turn dropping is silent, so raise this
# rather than wonder why long tool output is missing. Default 20000.
CC_LANGFUSE_MAX_CHARS=20000

# Copy to .env beside these scripts and fill in. Never commit the filled copy.
#
# retro_load.py loads this file with python-dotenv before importing langfuse.
# langfuse_admin.py prefers a .env here over ~/.env, matching the pod setup.
#
# Which project these keys address decides what every command touches, so
# LANGFUSE_PROJECT_ID is not optional here even though the SDK does not require
# it: langfuse_admin.py refuses to act unless a key names the project you asked
# for, rather than falling back to whichever key happens to be present.

LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_PROJECT_ID=

# Optional. Separates sandbox traces from real ones without needing a second
# project. Lowercase, digits, hyphen or underscore, 40 characters maximum, and
# it cannot start with "langfuse".
LANGFUSE_TRACING_ENVIRONMENT=

# Optional, read by the vendored hook. Turn dropping is silent, so raise this
# rather than wonder why long tool output is missing. Default 20000.
CC_LANGFUSE_MAX_CHARS=20000

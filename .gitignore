# Credentials. The README tells you to put a .env beside these scripts and
# langfuse_admin.py prefers it over ~/.env, so this repo actively asks you to
# create the file it must never commit.
.env
.env.*
!.env.example

__pycache__/
.venv/

# Deletion manifests. Written by `langfuse_admin.py delete --record` before
# anything is removed, so they hold trace ids, session ids and user ids for a
# real project. Useful locally, not something to publish.
deletion-record*.json
